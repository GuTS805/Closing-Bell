# Mainnet RPC used server-side by /api/truecost and /api/position (Pyth account
# reads + token balance lookups). Public endpoint is rate-limited under real
# traffic — use a Helius/Triton/QuickNode URL for anything beyond local dev.
MAINNET_RPC=https://api.mainnet-beta.solana.com

# Same mainnet RPC, exposed to the browser for the wallet connection on /position.
# Keep it in sync with MAINNET_RPC above.
NEXT_PUBLIC_MAINNET_RPC=https://api.mainnet-beta.solana.com

# Devnet RPC used by the live "send a fill" buttons on /proof.
DEVNET_RPC=https://api.devnet.solana.com

# Path to a funded devnet keypair with mint/burn authority over the guard's test
# mints (see scripts/deploy-devnet.ts). Required for the live devnet demo on
# /proof to work; without it, that section falls back to the two historical
# transactions and the live buttons return a clear error instead of crashing.
GUARD_KEYPAIR_PATH=~/.config/solana/id.json
