RPC_URL=https://api.mainnet-beta.solana.com
# Pyth Hermes now requires auth (verified 2026-09-18). Pyth Pro key from the hackathon perk.
PYTH_HERMES_URL=https://hermes.pyth.network
PYTH_API_KEY=
# Path to the fee-payer keypair used by scripts/keeper.
WALLET=~/.config/solana/id.json
